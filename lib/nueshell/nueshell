#!/usr/bin/env sh

###############################################################################################
#                                      Directory Management                                   #
###############################################################################################
# This is for creating file directories, with comcrirannuaire merging creation and navigation #
# into the same process.                                                                      #
###############################################################################################
commute_annuaire() {
  local dirname=$1

  cd "$dirname"
}

encrirannuaire() {
  local dirname=$1

  mkdir "$dirname"
}

comcrirannuaire() {
  local dirname=$1

  mkdir "$dirname"; cd "$dirname"
}

crelease() {
  local old_directory=$1

  encrirannuaire "bin"
  encrirannuaire "docs"
  encrirannuaire "licenses"
  encrirannuaire "msrc"
  encrirannuaire "mce"
  encrirannuaire "src"

  comcrirannuaire "lib"
  encrirannuaire  "sh"

  cd $old_directory

  enc '#!/usr/bin/env sh' > awashell
}

icijournal() {
  cat <<SOURCE
$1
SOURCE
}

###############################################################################################
#                                       Nuerisupu Execution                                   #
###############################################################################################
enc() {
  local input=$1

  echo "$input"
}

nucloth() {
  local script_name=$1

  ./nuerispu_clothed "$script_name"
}

nunake() {
  local script_name=$1

  ./nuerispu_naked "$script_name"
}

###############################################################################################
#                                   Generate Nuerisupu Outfits                                #
###############################################################################################
doarc() {
  local color=$1
  local shape=$2
  local size=$3

  echo "(arc $color $shape $size)" >> scripts/clothed/arc.nue
}

docor() {
  local color=$1
  local shape=$2
  local size=$3

  echo "(cor $color $shape $size)" >> scripts/clothed/arc.nue
}

dojup() {
  local color=$1
  local shape=$2
  local size=$3

  echo "(jup $color $shape $size)" >> scripts/clothed/arc.nue
}

dobas() {
  local color=$1
  local shape=$2
  local size=$3

  echo "(bas $color $shape $size)" >> scripts/clothed/arc.nue
}

dosab() {
  local color=$1
  local shape=$2
  local size=$3

  echo "(sab $color $shape $size)" >> scripts/clothed/arc.nue
}

###############################################################################################
#                                  Generate Counterfactuals                                   #
###############################################################################################
# Generates counterfactual and negative counterfactual expressions in the naked subset of     #
# naked lisp                                                                                  #
###############################################################################################
docfs() {
  local first_symbol=$1
  local first_description=$2

  local second_symbol=$3
  local second_description=$4

  local third_symbol=$5
  local third_description=$6

  echo "cfs $first_symbol $first_description $second_symbol $second_description $third_symbol $third_description" >> scripts/naked/counterfactuals.nue
}

donfs() {
  local first_symbol=$1
  local first_description=$2

  local second_symbol=$3
  local second_description=$4

  local third_symbol=$5
  local third_description=$6

  echo "nfs $first_symbol $first_description $second_symbol $second_description $third_symbol $third_description" >> scripts/naked/negative_counterfactuals.nue
}
